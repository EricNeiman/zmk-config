#include <dt-bindings/zmk/input_transform.h>

&pro_micro_i2c {
    status = "okay";

    tps43: iqs5xx@74 {
        compatible = "azoteq,iqs5xx";
        reg = <0x74>;
        status = "okay";
        rdy-gpios = <&pro_micro 1 (GPIO_ACTIVE_HIGH)>;
        reset-gpios = <&pro_micro 0 (GPIO_ACTIVE_LOW)>;

        /* Gesture & Feature Configuration */
        one-finger-tap;
        press-and-hold;
        press-and-hold-time = <250>;
        two-finger-tap;
        scroll;
        /* natural-scroll-y; */
        /* natural-scroll-x; */
        /* switch-xy; */
    };
};

/ {
    trackpad_listener {
        compatible = "zmk,input-listener";
        device = <&tps43>;
    };
};
